# Oria — variáveis do serviço hospedado (ORIA_MODE=hosted). Sem segredos aqui: só nomes e exemplos.
# Local (npm run dev) não precisa de nada disto.

ORIA_MODE=hosted
# PORT é injetada pela plataforma (Railway); não fixe.
DATA_DIR=/data                                   # volume persistente (banco, cópias, mídia local)
PANEL_ORIGIN=https://painel.seudominio.com.br    # painel; único host que aceita escrita e enquadra a prévia
PUBLIC_ORIGIN=https://api.seudominio.com.br      # serviço público (CONFIG_SERVICE_URL do Worker das lojas)
APP_SECRET=                                      # openssl rand -base64 32 (assina prévias, cifra tokens da INK)

# Prévia antes da instalação: endereço de teste de cada loja no Worker de teste.
TEST_STORE_SCHEME=https
# TEST_STORE_PORT=                               # vazio em produção

# Mídia no R2 (API S3). Sem isto, a mídia fica no volume.
MEDIA_BACKEND=r2
R2_ACCOUNT_ID=
R2_BUCKET=oria-midia
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT=https://<conta>.r2.cloudflarestorage.com

# E-mail (convites e "esqueci a senha"). Sem isto: caixa de saída local e o painel mostra o link.
MAIL_PROVIDER=resend
RESEND_API_KEY=
MAIL_FROM=Oria <acesso@seudominio.com.br>        # remetente de domínio verificado na Resend

# Primeiro operador (só na primeira subida)
OPERATOR_EMAIL=
OPERATOR_NAME=
# OPERATOR_PASSWORD=                             # ou deixe vazio: o log mostra um link de convite

# Rotinas (padrão no hospedado)
# SYNC_EVERY_MIN=60                              # leitura periódica das lojas
# BACKUP_EVERY_HOURS=24                          # cópia do banco (local e R2)
