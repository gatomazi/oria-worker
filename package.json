{
  "name": "personalizacoes-ink",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=23.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261024.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "miniflare": "^4.20260730.0",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.152.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "start:local": "node src/platform/main.ts",
    "start:worker": "wrangler dev",
    "demo:setup": "node scripts/demo-setup.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/worker/tsconfig.json",
    "test": "node scripts/build.mjs && node --test --test-concurrency=1 --test-timeout=60000 test/*.test.ts",
    "e2e": "node scripts/build.mjs && node scripts/e2e.mjs",
    "check:loja": "node scripts/check-loja.mjs",
    "check": "npm run typecheck && npm test",
    "start": "node src/platform/main.ts",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "check:api": "node scripts/check-api.mjs"
  },
  "dependencies": {
    "jsdom": "^30.1.3"
  }
}
